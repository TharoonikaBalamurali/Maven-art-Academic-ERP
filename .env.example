# Copy to .env.development / .env.staging / .env.production. Never commit real values.

# "mock" routes every request to the in-repo mock API. "http" calls VITE_API_BASE_URL.
VITE_API_MODE=mock

# Base URL of the backend API. Required when VITE_API_MODE=http.
VITE_API_BASE_URL=http://localhost:8000/api

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Artificial latency for the mock transport, in milliseconds.
VITE_MOCK_LATENCY_MS=300

VITE_APP_NAME=Maven Art Academic ERP
VITE_APP_ENV=development
